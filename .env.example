# Where the learned selector overrides are persisted.
HOUND_DB=hound-selectors.db

# Default and maximum token ceiling per tool response.
# MAX is a hard cap: a caller cannot request more than this in one call.
HOUND_DEFAULT_BUDGET=1200
HOUND_MAX_BUDGET=20000

# Set to 0 to watch the browser work (requires a display).
HOUND_HEADLESS=1

# Optional: proxy for sites that need a specific egress IP.
# HTTPS_PROXY=http://user:pass@host:port
